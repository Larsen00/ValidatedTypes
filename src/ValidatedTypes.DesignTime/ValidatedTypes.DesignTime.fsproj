<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFrameworks>netstandard2.0</TargetFrameworks>
    <DefineConstants>IS_DESIGNTIME</DefineConstants>
    <!-- This allows the component to execute from 'bin' directory during build -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <!-- Mirrors JsonSchemaProvider.DesignTime's own convention: co-locates this DLL with
         ValidatedTypes.Runtime's output (where its TypeProviderAssembly attribute looks for it)
         without needing Runtime's self-reference to be unconditional - see the Condition on that
         ProjectReference in ValidatedTypes.Runtime.fsproj for why it needs to stay conditional. -->
    <BaseOutputPath Condition="$(IsNuGet) == ''">..\ValidatedTypes.Runtime\bin</BaseOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\paket-files\fsprojects\FSharp.TypeProviders.SDK\src\ProvidedTypes.fsi">
      <Paket>True</Paket>
      <Link>paket-files/ProvidedTypes.fsi</Link>
    </Compile>
    <Compile Include="..\..\paket-files\fsprojects\FSharp.TypeProviders.SDK\src\ProvidedTypes.fs">
      <Paket>True</Paket>
      <Link>paket-files/ProvidedTypes.fs</Link>
    </Compile>
    <Compile Include="AssemblyInfo.fs" />
    <Compile Include="..\ValidatedTypes.Runtime\ValidatedTypes.Runtime.fs" />
    <Compile Include="..\ValidatedTypes.Runtime\Types\Number.fs" />
    <Compile Include="..\ValidatedTypes.Runtime\Types\Integer.fs" />
    <Compile Include="..\ValidatedTypes.Runtime\Types\List.fs" />
    <Compile Include="..\ValidatedTypes.Runtime\Types\String.fs" />
    <Compile Include="ValidatedTypes.DesignTime.fs" />
    <None Include="paket.references" />
  </ItemGroup>
  <ItemGroup>
   <!-- 
    To use a reference to the FSharp.TypeProviders.SDK nuget package, do this:
    
    <PackageReference Include="FSharp.TypeProviders.SDK" Version="7.0.3">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    -->
    <!-- No ExcludeAssets here (unlike JsonSchemaProvider.DesignTime's copy of this override):
         CopyLocalLockFileAssemblies above exists specifically so this assembly is self-contained
         in its own bin folder, since ValidatedTypes.Runtime.fsproj loads it as an isolated
         type-provider host - which requires FSharp.Core.dll itself to be physically present
         there, not excluded. Confirmed by testing: excluding it produces FS3048 "could not load
         file or assembly FSharp.Core...". -->
    <PackageReference Update="FSharp.Core" Version="10.0.102" />
    <!-- PrivateAssets=all: same reasoning as ValidatedTypes.Runtime.fsproj's copy of this
         reference - stops it propagating into whoever references this project directly
         (e.g. JsonSchemaProvider.DesignTime). -->
    <PackageReference Include="JsonSchemaProvider" Version="0.1.2">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- JsonSchemaProvider 0.1.2's isolated type-provider design-time host
         (typeproviders/fsharp41) was built against older versions of these
         transitive dependencies than its nuspec declares. Without pinning
         them, NuGet resolves the nuspec-declared (newer) versions into our
         bin output, which the design-time host then refuses to load
         (assembly manifest mismatch). -->
    <PackageReference Include="NJsonSchema" Version="11.0.2" />
    <PackageReference Include="FSharp.Data.Json.Core" Version="6.4.0" />
  </ItemGroup>
  <PropertyGroup>
    <NoWarn>$(NoWarn);NU1605</NoWarn>
  </PropertyGroup>
  <Import Project="..\..\.paket\Paket.Restore.targets" />
</Project>